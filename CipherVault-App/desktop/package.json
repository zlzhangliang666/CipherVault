{
  "name": "ciphervault-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "CipherVault 单机版桌面外壳（Electron）",
  "main": "main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "npm --prefix ../frontend run dev",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_URL=http://localhost:5173 electron .",
    "build:renderer": "npm --prefix ../frontend run build",
    "dist": "npm run build:renderer && electron-builder --win nsis portable",
    "dist:dir": "npm run build:renderer && electron-builder --win --dir"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.ciphervault.desktop",
    "productName": "CipherVault",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "storage.cjs",
      "package.json",
      "renderer/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CipherVault-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CipherVault-Portable-${version}.${ext}"
    }
  }
}
